# Copy this file to .env on the SERVER (the machine that runs `streamlit run app.py`) and set your key.
# The key is read only by the backend. It is never typed into, shown in, or sent to the browser. NEVER commit .env.
GEMINI_API_KEY=your-key-here
# Optional. Defaults to gemini-3.8-flash, falling back to 3.7, 3.5 and 3.5-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash
